# 複製這個檔案為 .env，填入正式值後放到伺服器上的 new_Home/ 目錄。
# .env 本身不可提交進 git（已加入 .gitignore）。

# 用來簽署下載連結 HMAC 的密鑰，可自訂一串隨機字串
DOWNLOAD_SECRET=

# Gmail API OAuth2 憑證（透過 oauth 授權流程取得，僅供內部一次性使用；
# 取得後請勿把授權/測試腳本留在版本庫中）
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# 寄件人資訊（可省略，未設定時預設為 sales@elgens.com.tw / ELGENS）
GMAIL_FROM_EMAIL=sales@elgens.com.tw
GMAIL_FROM_NAME=ELGENS
